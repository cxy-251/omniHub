#!/bin/sh
# omniHub AppImage 入口：启动服务，服务就绪后打开同目录的桌面客户端。有参数时原样传给服务（如 --version）。
# 不设置 LD_LIBRARY_PATH 等环境变量：服务拉起的游戏会继承环境，打包的 Qt/ffmpeg 库不能漏进游戏。
# 打包的程序自带 RPATH 与 qt.conf，自己找得到库和插件。
HERE=$(dirname "$(readlink -f "$0")")
if [ "$#" -eq 0 ]; then set -- --desktop; fi
exec "$HERE/usr/bin/omnihub-server" "$@"
