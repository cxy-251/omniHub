[Desktop Entry]
Type=Application
Name=omniHub Player
Comment=Open audio and video in the independent omniHub player
Exec=omnihub-client -- %F
TryExec=omnihub-client
Icon=video-x-generic
Terminal=false
Categories=AudioVideo;Player;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;audio/mpeg;audio/flac;audio/ogg;audio/x-wav;audio/mp4;audio/opus;
StartupNotify=true
